DATABASE_URL=postgresql://tracker:PASSWORD@127.0.0.1:5433/trade_tracker
PORT=3101
POLL_INTERVAL_MS=15000
WEEKLY_DOW=0
WEEKLY_HOUR_UTC=18
TRACKER_API_KEY=change-me
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_BTC=
DISCORD_WEBHOOK_URL_XRP=

# Blofin live execution (whitelist bot IP 5.78.142.246 on the API key)
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=
BLOFIN_BASE_URL=https://openapi.blofin.com
# 0 = dry-run (log only), 1 = real orders
BLOFIN_LIVE=0
# BloFin MCP API keys (UI: “BloFin MCP API”) need the MCP broker id.
# Default in code: dd3511977f23cc87 (official blofin-mcp). Set none for Transaction keys.
BLOFIN_BROKER_ID=dd3511977f23cc87
# Fraction of free available margin per new trade (0.5 = 50%)
BLOFIN_MARGIN_FRACTION=0.5
# Fallback only if balance fetch fails
BLOFIN_DEFAULT_MARGIN_USDT=10
BLOFIN_MAX_LEVERAGE=3
BLOFIN_MARGIN_MODE=isolated
# Desk symbol → Blofin SWAP instId
# XRP-USD inverse uses XRP margin (COIN-FUTURES). XRP-USDT linear needs free USDT.
BLOFIN_SYMBOL_MAP=BTCUSDT:BTC-USDT,XRPUSDT:XRP-USD

# --- Standalone LTF scalp desk (server-only, open-port dashboard) ---
DESK_ENABLED=0
DESK_SYMBOLS=BTCUSDT,XRPUSDT
DESK_LTF=15m
DESK_HTF=1h
DESK_MODE=smc
DESK_MIN_RR=1.3
DESK_MIN_CONFLUENCE=2
DESK_MAX_SETUPS_PER_RUN=2
DESK_MAX_TOOL_ITERS=8
# 6 hours (avoid cancelling good pending setups every 15m)
DESK_ANALYSIS_INTERVAL_MS=21600000
XAI_API_KEY=
XAI_PRIMARY_MODEL=grok-4.6
XAI_FALLBACK_MODEL=grok-4-1-fast-reasoning
# Institutional tools (optional; Binance fapi used if unset)
COINGLASS_API_KEY=
COINALYZE_API_KEY=

# Continuous SMC map (read-only for Grok). Polls klines and persists zones.
SMC_ENGINE_INTERVAL_MS=60000

# Paper account — small risk, capped leverage (steady wins, not max size)
PAPER_STARTING_EQUITY=1000
PAPER_RISK_PCT=0.0075
PAPER_MAX_LEVERAGE=2
PAPER_MAX_MARGIN_FRAC=0.15
PAPER_MAX_OPEN_RISK_PCT=0.02
PAPER_HALT_DD_PCT=0.25
PAPER_SOURCES=xrp_struct,xrp_scalp,scalp_desk
