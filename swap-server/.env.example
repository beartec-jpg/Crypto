# ─────────────────────────────────────────────────────────────
# QBTC Swap Server — Environment Variables
# ─────────────────────────────────────────────────────────────

# Server port (default 3099)
PORT=3099

# Allowed CORS origins (comma-separated). REQUIRED in production — no wildcard default.
# Example: CORS_ORIGINS=https://app.example.com,https://swap.example.com
# In development only, if unset defaults to localhost origins (3000/5173/5174) with a warning.
CORS_ORIGINS=https://your-frontend-domain.example.com

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── QBTC RPC (for HTLC lock verification) ──────────────────
QBTC_RPC_URL=http://127.0.0.1:28332
QBTC_RPC_USER=your_rpc_user
QBTC_RPC_PASSWORD=your_rpc_password

# ─── EVM / HTLC  (for EVM lock verification + monitor) ──────

# USDC — HashedTimelockERC20 (already deployed on Sepolia)
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_HTLC_CONTRACT=0xaF898a5F565c0cAE1746122ad475c0B7F160A3eb
USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ETH — HashedTimelockETH on Ethereum Sepolia (deploy via contracts/HashedTimelockETH.sol)
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_HTLC_CONTRACT=0x...

# BNB — HashedTimelockETH on BSC Testnet (deploy via contracts/HashedTimelockETH.sol)
BNB_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BNB_HTLC_CONTRACT=0x...

# XRP Ledger — XRPL escrow monitor (uses PREIMAGE-SHA-256 crypto-conditions)
# Leave unset to disable the XRP monitor
# XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
