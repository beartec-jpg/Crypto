# ─────────────────────────────────────────────────────────────────────────────
# .env.test.example
#
# Environment variables for the QBTC ↔ USDC atomic swap end-to-end test.
#
# Usage:
#   cp .env.test.example .env.test
#   # Fill in real values, then choose ONE of:
#
#   # Option A — Node.js ≥ 20 built-in env file loader:
#   node --env-file=.env.test --import=tsx/esm scripts/test-atomic-swap-e2e.ts
#
#   # Option B — inline via xargs (no spaces in values):
#   env $(grep -v '^#' .env.test | grep '=' | xargs) tsx scripts/test-atomic-swap-e2e.ts
#
#   # Option C — source then run:
#   set -a && source .env.test && set +a && tsx scripts/test-atomic-swap-e2e.ts
# ─────────────────────────────────────────────────────────────────────────────

# ── Swap server ───────────────────────────────────────────────────────────────
# URL of the running QBTC swap server (swap-server/index.ts).
# Use the local dev server or the remote VPS endpoint.
SWAP_API_URL=http://localhost:3099

# ── Seller (QBTC holder) ──────────────────────────────────────────────────────
# Ethereum private key for the seller (hex, with 0x prefix).
# Used to sign swap API messages and to withdraw USDC from the EVM HTLC.
# Fund this address with a small amount of Sepolia ETH for gas (~0.002 ETH).
SELLER_EVM_PRIVKEY=0xYOUR_SELLER_ETHEREUM_PRIVATE_KEY

# ECDSA secp256k1 private key for the seller's QBTC key pair (hex, 64 chars, no 0x).
# Used to derive sellerPubKeyHex for the HTLC script refund branch.
# This key does NOT need to control the seller QBTC wallet — it is only used
# for key derivation.  The actual QBTC send uses SELLER_QBTC_WALLET via RPC.
SELLER_QBTC_PRIVKEY=YOUR_SELLER_QBTC_ECDSA_PRIVATE_KEY_64HEX

# Bech32 QBTC address that the seller's funds are held in.
# Must be funded with at least QBTC_AMOUNT + 0.0001 QBTC (fee).
# This is the address belonging to the wallet identified by SELLER_QBTC_WALLET.
SELLER_QBTC_ADDRESS=qbtct1qYOUR_SELLER_QBTC_ADDRESS

# Name of the QBTC wallet loaded on the RPC node that holds the seller's QBTC.
# Leave empty to use the default wallet.
# The wallet must be unlocked; run `walletpassphrase <pass> 600` on the node if needed.
SELLER_QBTC_WALLET=seller

# ── Buyer (USDC holder) ───────────────────────────────────────────────────────
# Ethereum private key for the buyer (hex, with 0x prefix).
# Used to sign swap API messages, approve USDC, and lock into the EVM HTLC.
# Fund this address with:
#   • At least USDC_AMOUNT USDC (Sepolia USDC — see faucet below)
#   • At least 0.01 ETH for gas (USDC approve + newContract calls)
# Sepolia USDC faucet: https://faucet.circle.com
BUYER_EVM_PRIVKEY=0xYOUR_BUYER_ETHEREUM_PRIVATE_KEY

# ECDSA secp256k1 private key for the buyer's QBTC key pair (hex, 64 chars, no 0x).
# Used to derive buyerPubKeyHex supplied to the swap server.
BUYER_QBTC_PRIVKEY=YOUR_BUYER_QBTC_ECDSA_PRIVATE_KEY_64HEX

# Bech32 QBTC address where the buyer will receive the claimed QBTC.
# This address must be valid on the QBTC network (prefix: qbtct for testnet).
BUYER_QBTC_ADDRESS=qbtct1qYOUR_BUYER_QBTC_ADDRESS

# ── Swap amounts ──────────────────────────────────────────────────────────────
# QBTC amount to swap (decimal string, e.g. "0.001")
QBTC_AMOUNT=0.001

# USDC amount to swap (decimal string with up to 6 decimals, e.g. "10.000000")
USDC_AMOUNT=10.000000

# ── QBTC node RPC ─────────────────────────────────────────────────────────────
# HTTP RPC URL of a QBTC node with a funded wallet loaded.
QBTC_RPC_URL=http://89.167.109.241:28332
QBTC_RPC_USER=qbtcverify
QBTC_RPC_PASSWORD=verify_node3_2026

# ── EVM / Sepolia ─────────────────────────────────────────────────────────────
# Sepolia RPC endpoint (public or private).
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# HashedTimelockERC20 contract deployed on Sepolia (deploy with scripts/deploy-htlc.js).
EVM_HTLC_CONTRACT=0xaF898a5F565c0cAE1746122ad475c0B7F160A3eb

# USDC token contract on Sepolia (Circle's test USDC).
USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── Optional ──────────────────────────────────────────────────────────────────
# QBTC network: testnet (default) or mainnet
QBTC_NETWORK=testnet

# Minimum Sepolia ETH balances required for gas checks (in ETH).
# Decrease these if your gas costs are lower.
MIN_BUYER_ETH=0.005
MIN_SELLER_ETH=0.001

# QBTC timelock duration in hours (default: 48). The EVM timelock is always half this value.
# Warning: shortening this below 2h is unsafe for real swaps but fine for testing.
QBTC_LOCKTIME_HOURS=48
