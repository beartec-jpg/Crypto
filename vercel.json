{
  "version": 2,
  "installCommand": "npm install --include=dev && cd cold-signer && npm install && cd ../qbtc-wallet && npm install",
  "buildCommand": "npx vite build && cd cold-signer && npx vite build && cp -r dist ../dist/cold-signer && cd ../qbtc-wallet && npx vite build && cp -r dist ../dist/qbtc-wallet",
  "outputDirectory": "dist",
  "functions": {
    "api/crypto/order-flow-alerts.ts": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "api/_lib/**"
    },
    "api/crypto/order-flow-alerts-multi-tf.ts": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "api/_lib/**"
    },
    "api/cron/discord-btc-pre-london.ts": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": ["api/_lib/**", "client/public/beartec-logo.png"]
    },
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/_lib/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/collect-liquidation-data",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/compute-heatmap-profiles",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/check-alerts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/refresh-crypto-ai-general",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/refresh-crypto-ai-general",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/refresh-crypto-ai-general",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/discord-btc-pre-london",
      "schedule": "45 5 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/swap/v2/lock/side-a", "destination": "http://204.168.175.194:3099/api/swap/v2/lock/side-a" },
    { "source": "/api/swap/v2/lock/side-b", "destination": "http://204.168.175.194:3099/api/swap/v2/lock/side-b" },
    { "source": "/api/swap/v2/claim/side-b", "destination": "http://204.168.175.194:3099/api/swap/v2/claim/side-b" },
    { "source": "/api/swap/v2/swap/:swapId/cancel", "destination": "http://204.168.175.194:3099/api/swap/v2/swap/:swapId/cancel" },
    { "source": "/api/swap/v2/offer/:offerId/cancel", "destination": "http://204.168.175.194:3099/api/swap/v2/offer/:offerId/cancel" },
    { "source": "/api/swap/v2/by-address", "destination": "http://204.168.175.194:3099/api/swap/v2/by-address" },
    { "source": "/api/swap/v2/accept/:offerId", "destination": "http://204.168.175.194:3099/api/swap/v2/accept/:offerId" },
    { "source": "/api/swap/v2/offer", "destination": "http://204.168.175.194:3099/api/swap/v2/offer" },
    { "source": "/api/swap/v2/offers", "destination": "http://204.168.175.194:3099/api/swap/v2/offers" },
    { "source": "/api/swap/v2/stats", "destination": "http://204.168.175.194:3099/api/swap/v2/stats" },
    { "source": "/api/swap/v2/pairs", "destination": "http://204.168.175.194:3099/api/swap/v2/pairs" },
    { "source": "/api/swap/v2/offers/all", "destination": "http://204.168.175.194:3099/api/swap/v2/offers/all" },
    { "source": "/api/swap/v2/:swapId", "destination": "http://204.168.175.194:3099/api/swap/v2/:swapId" },
    { "source": "/api/swap/cancel/:offerId", "destination": "http://204.168.175.194:3099/api/swap/cancel/:offerId" },
    { "source": "/api/swap/accept/:offerId", "destination": "http://204.168.175.194:3099/api/swap/accept/:offerId" },
    { "source": "/api/swap/lock/qbtc", "destination": "http://204.168.175.194:3099/api/swap/lock/qbtc" },
    { "source": "/api/swap/lock/offer", "destination": "http://204.168.175.194:3099/api/swap/lock/offer" },
    { "source": "/api/swap/lock/evm", "destination": "http://204.168.175.194:3099/api/swap/lock/evm" },
    { "source": "/api/swap/secret/seller", "destination": "http://204.168.175.194:3099/api/swap/secret/seller" },
    { "source": "/api/swap/claim/qbtc", "destination": "http://204.168.175.194:3099/api/swap/claim/qbtc" },
    { "source": "/api/swap/by-address", "destination": "http://204.168.175.194:3099/api/swap/by-address" },
    { "source": "/api/swap/offer", "destination": "http://204.168.175.194:3099/api/swap/offer" },
    { "source": "/api/swap/stats", "destination": "http://204.168.175.194:3099/api/swap/stats" },
    { "source": "/api/swap/buy-offer", "destination": "http://204.168.175.194:3099/api/swap/buy-offer" },
    { "source": "/api/swap/buy-offers", "destination": "http://204.168.175.194:3099/api/swap/buy-offers" },
    { "source": "/api/swap/accept-buy/:offerId", "destination": "http://204.168.175.194:3099/api/swap/accept-buy/:offerId" },
    { "source": "/api/swap/offers", "destination": "http://204.168.175.194:3099/api/swap/offers" },
    { "source": "/api/swap/health", "destination": "http://204.168.175.194:3099/api/swap/health" },
    { "source": "/api/swap/:swapId", "destination": "http://204.168.175.194:3099/api/swap/:swapId" },
    { "source": "/api/crypto/elliott-wave/labels/:id", "destination": "/api/crypto/elliott-wave/labels/[id]" },
    { "source": "/api/crypto/projection-lines/:id", "destination": "/api/crypto/projection-lines/[id]" },
    { "source": "/api/crypto/chart-drawings/:id", "destination": "/api/crypto/chart-drawings/[id]" },
    { "source": "/api/crypto/feedback-board/replies/:id", "destination": "/api/crypto/feedback-board/replies/[id]" },
    { "source": "/api/crypto/feedback-board/:id/replies", "destination": "/api/crypto/feedback-board/[id]/replies" },
    { "source": "/api/crypto/feedback-board/:id", "destination": "/api/crypto/feedback-board/[id]" },
    { "source": "/((?!api/|cold-signer/|qbtc-wallet/|qbtc-browser-miner-worker\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    }
  ]
}