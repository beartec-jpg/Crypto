# ─────────────────────────────────────────────────────────────
# QBTC Testnet RPC – required for scan and faucet pages
# ─────────────────────────────────────────────────────────────

# Comma-separated list of QBTC testnet node URLs (primary config).
# The failover helper will probe all nodes and route to the most
# up-to-date one. QBTC_RPC_URL is a single-node backward-compat
# fallback used only when QBTC_RPC_NODES is absent.
QBTC_RPC_NODES=http://89.167.109.241:28332,http://46.62.156.169:28332,http://37.27.47.236:28332

# Per-node RPC credentials, comma-separated "user:pass" pairs aligned
# with QBTC_RPC_NODES above. Required when nodes have different
# credentials. If absent, QBTC_RPC_USER/QBTC_RPC_PASSWORD are used
# as shared credentials for every node.
QBTC_RPC_NODES_AUTH=user1:pass1,user2:pass2,user3:pass3

# Shared RPC credentials (set these as Vercel secrets – do NOT commit real values here).
QBTC_RPC_USER=your_rpc_user
QBTC_RPC_PASSWORD=your_rpc_password

# ─────────────────────────────────────────────────────────────
# QBTC Faucet – required for faucet page
# ─────────────────────────────────────────────────────────────

# URL of the node that holds the faucet wallet (must be the miner/S1 node).
QBTC_FAUCET_NODE=http://89.167.109.241:28332

# Name of the wallet loaded on QBTC_FAUCET_NODE that funds faucet payouts.
QBTC_FAUCET_WALLET=miner

# ─────────────────────────────────────────────────────────────
# QBTC Mainnet (disabled until mainnet launch)
# ─────────────────────────────────────────────────────────────
QBTC_MAINNET_ACTIVE=false
# QBTC_MAINNET_RPC_URL=
# QBTC_MAINNET_RPC_USER=
# QBTC_MAINNET_RPC_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Swap API — dedicated server (leave empty to use Vercel /api/swap)
# ─────────────────────────────────────────────────────────────
# VITE_SWAP_API_URL=http://89.167.109.241:3099

# ─────────────────────────────────────────────────────────────
# QBTC mining pool proxy (required for /api/qbtc/pool-stats and /api/qbtc/browser-miner)
# ─────────────────────────────────────────────────────────────
# Use HTTPS in production (HTTP allowed only for localhost development).
QBTC_POOL_STATS_URL=https://pool.example.com/stats
QBTC_POOL_HTTP_BASE_URL=https://pool.example.com

# Comma-separated web origins allowed to call mining endpoints cross-origin.
# Leave empty to block all cross-origin browser calls (same-origin still works).
# Example: https://crypto.beartec.com,https://staging-crypto.beartec.com
QBTC_MINING_CORS_ORIGINS=

# Allow requests without an Origin header (server-to-server callers).
# Keep false for strict browser-origin enforcement.
QBTC_MINING_ALLOW_ORIGINLESS=false

# Per-IP submit request budget for browser miner proxy (/browser-miner?action=submit).
QBTC_BROWSER_MINER_SUBMIT_RATE_LIMIT_PER_MINUTE=120
